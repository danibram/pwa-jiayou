{
  "name": "jiayou",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @jiayou/web",
    "build": "npm run build -w @jiayou/web",
    "preview": "npm run preview -w @jiayou/web",
    "test": "npm run test -w @jiayou/web",
    "editor": "npm run dev -w @jiayou/editor",
    "typecheck": "npm run typecheck --workspaces",
    "check": "npm run check -w @jiayou/web && npm test -w @jiayou/editor && npm run typecheck -w @jiayou/editor",
    "strokes": "node scripts/copy-strokes.mjs",
    "search-index": "node scripts/build-search-index.mjs",
    "fetch-hsk": "node scripts/fetch-hsk-from-hanzidb.mjs",
    "media-packs": "node scripts/build-media-packs.mjs",
    "localize-hsk": "node scripts/localize-hsk456.mjs",
    "build-vocabulary": "node scripts/build-vocabulary.mjs",
    "localize-vocabulary": "node scripts/localize-vocabulary.mjs",
    "published-ids": "node scripts/published-ids.mjs"
  },
  "devDependencies": {
    "esbuild": "0.21.5",
    "typescript": "^5.3.3"
  }
}
